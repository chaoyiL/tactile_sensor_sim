{
  "backend": "mujoco",
  "surface": {"size_mm": [17.3, 29.14], "view_side_z": -1},
  "indentation": {"center_xy_mm": [0.0, 0.0], "radius_mm": 6.0, "depth_mm": 1.0, "direction_z": -1},
  "mujoco": {
    "python_executable": ".venv-xense/Scripts/python.exe",
    "sensor_mode": "simple",
    "calibrate_file": "bundled:g1-ws_table",
