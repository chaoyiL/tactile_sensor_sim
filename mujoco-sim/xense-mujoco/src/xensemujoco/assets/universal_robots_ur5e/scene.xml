<mujoco model="ur5e scene">
  <include file="ur5e_xp.xml"/>

  <statistic center="0.3 0 0.4" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <body name="block">
      <freejoint name="block_free"/>
      <geom name="block_geom"
            pos="0 0.5 0.5"
            type="box" size="0.015 0.015 0.015"
            rgba="0.9 0.3 0.2 1"
            />     
    </body>

    <body name="target_body" mocap="true" pos="0 0.5 0.8" euler="3.1415926 0 0">
      <geom type="sphere" size="0.005" rgba="0.1 0.8 0.1 0" contype="0" conaffinity="0"/>
      <site name="target" pos="0 0 0" rgba="0.1 0.8 0.1 0" />
    </body>

    <camera name="front_cam" pos="-0.501 1.384 1.564" xyaxes="-0.905 -0.425 -0.000 0.264 -0.563 0.783"/>

    <body name="camera" pos="0.8 0.0 1.2">
        <camera name="agentview" pos="0 0 0" xyaxes="0 1 0  -0.5 0 0.707" fovy="60" />
    </body>

    <body name="camera2" pos="0.5 0.0 1.8">
        <camera name="topview" pos="0 0 0" xyaxes="0 -1 0 1 0 0" fovy="90" />
    </body>

    <body name="camera3" pos="0.3 -0.7 1.3">
        <camera name="sideview" pos="0 0 0" xyaxes="1 0 0 0 0 1" fovy="90" />
    </body>

  </worldbody>
</mujoco>
